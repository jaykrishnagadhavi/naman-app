# Supabase Configuration
# Local instance default: http://127.0.0.1:54321
# Remote instance format: https://<project-ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Accounts
# Comma-separated list of admin email addresses (used by 'pnpm seed:admin')
ADMIN_EMAILS=admin@abrainoconcious.com,creator@abrainoconcious.com

